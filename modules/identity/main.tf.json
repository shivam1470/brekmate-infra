{
  "variable": {
    "name": {
      "type": "string",
      "description": ""
    },
    "production": {
      "type": "bool",
      "description": ""
    },
    "tags": {
      "type": "map(string)",
      "description": "",
      "default": {}
    }
  },
  "resource": {
    "aws_cognito_user_pool": {
      "customer": {
        "name": "${var.name}-customers",
        "username_attributes": [
          "email"
        ],
        "auto_verified_attributes": [
          "email"
        ],
        "username_configuration": [
          {
            "case_sensitive": false
          }
        ],
        "deletion_protection": "${var.production ? \"ACTIVE\" : \"INACTIVE\"}",
        "password_policy": [
          {
            "minimum_length": 12,
            "require_lowercase": true,
            "require_uppercase": true,
            "require_numbers": true,
            "require_symbols": true
          }
        ],
        "account_recovery_setting": [
          {
            "recovery_mechanism": [
              {
                "name": "verified_email",
                "priority": 1
              }
            ]
          }
        ],
        "tags": "${var.tags}",
        "lifecycle": {
          "prevent_destroy": true
        },
        "user_pool_tier": "LITE"
      },
      "staff": {
        "name": "${var.name}-staff",
        "username_attributes": [
          "email"
        ],
        "auto_verified_attributes": [
          "email"
        ],
        "username_configuration": [
          {
            "case_sensitive": false
          }
        ],
        "admin_create_user_config": [
          {
            "allow_admin_create_user_only": true
          }
        ],
        "mfa_configuration": "ON",
        "software_token_mfa_configuration": [
          {
            "enabled": true
          }
        ],
        "deletion_protection": "${var.production ? \"ACTIVE\" : \"INACTIVE\"}",
        "password_policy": [
          {
            "minimum_length": 14,
            "require_lowercase": true,
            "require_uppercase": true,
            "require_numbers": true,
            "require_symbols": true
          }
        ],
        "tags": "${var.tags}",
        "lifecycle": {
          "prevent_destroy": true
        },
        "user_pool_tier": "LITE"
      }
    },
    "aws_cognito_user_pool_client": {
      "customer": {
        "name": "${var.name}-mobile",
        "user_pool_id": "${aws_cognito_user_pool.customer.id}",
        "generate_secret": false,
        "explicit_auth_flows": [
          "ALLOW_USER_SRP_AUTH",
          "ALLOW_REFRESH_TOKEN_AUTH"
        ],
        "prevent_user_existence_errors": "ENABLED",
        "enable_token_revocation": true,
        "access_token_validity": 15,
        "id_token_validity": 15,
        "refresh_token_validity": 7,
        "token_validity_units": [
          {
            "access_token": "minutes",
            "id_token": "minutes",
            "refresh_token": "days"
          }
        ]
      },
      "staff": {
        "name": "${var.name}-staff-web",
        "user_pool_id": "${aws_cognito_user_pool.staff.id}",
        "generate_secret": false,
        "explicit_auth_flows": [
          "ALLOW_USER_SRP_AUTH",
          "ALLOW_REFRESH_TOKEN_AUTH"
        ],
        "prevent_user_existence_errors": "ENABLED",
        "enable_token_revocation": true,
        "access_token_validity": 15,
        "id_token_validity": 15,
        "refresh_token_validity": 1,
        "token_validity_units": [
          {
            "access_token": "minutes",
            "id_token": "minutes",
            "refresh_token": "days"
          }
        ]
      }
    },
    "aws_cognito_user_group": {
      "staff": {
        "for_each": "${toset([\"OWNER\", \"MANAGER\", \"KITCHEN\", \"OPERATOR\", \"RIDER\"])}",
        "name": "${each.value}",
        "user_pool_id": "${aws_cognito_user_pool.staff.id}"
      }
    }
  },
  "output": {
    "issuers": {
      "value": {
        "customer": "https://${aws_cognito_user_pool.customer.endpoint}",
        "staff": "https://${aws_cognito_user_pool.staff.endpoint}"
      }
    },
    "clients": {
      "value": {
        "customer": "${aws_cognito_user_pool_client.customer.id}",
        "staff": "${aws_cognito_user_pool_client.staff.id}"
      }
    },
    "pool_ids": {
      "value": {
        "customer": "${aws_cognito_user_pool.customer.id}",
        "staff": "${aws_cognito_user_pool.staff.id}"
      }
    }
  }
}
