{
  "variable": {
    "name": {
      "type": "string",
      "description": ""
    },
    "region": {
      "type": "string",
      "description": ""
    },
    "account_id": {
      "type": "string",
      "description": ""
    },
    "tags": {
      "type": "map(string)",
      "description": "",
      "default": {}
    },
    "table_names": {
      "type": "map(string)",
      "description": ""
    },
    "table_arns": {
      "type": "map(string)",
      "description": ""
    },
    "secret_arns": {
      "type": "list(string)",
      "description": ""
    },
    "issuers": {
      "type": "map(string)",
      "description": ""
    },
    "clients": {
      "type": "map(string)",
      "description": ""
    },
    "artifact_path": {
      "type": "string",
      "description": ""
    },
    "handler": {
      "type": "string",
      "description": "",
      "default": "index.handler"
    },
    "runtime": {
      "type": "string",
      "description": "",
      "default": "nodejs24.x"
    },
    "architecture": {
      "type": "string",
      "description": "",
      "default": "arm64"
    },
    "memory_mb": {
      "type": "number",
      "description": "",
      "default": 256
    },
    "timeout_seconds": {
      "type": "number",
      "description": "",
      "default": 15
    },
    "concurrency": {
      "type": "number",
      "description": "",
      "default": 5
    },
    "log_days": {
      "type": "number",
      "description": "",
      "default": 7
    },
    "boundary_arn": {
      "type": "string",
      "description": ""
    },
    "origins": {
      "type": "list(string)",
      "description": "",
      "default": []
    },
    "routes": {
      "type": "map(string)",
      "description": "",
      "default": {},
      "validation": [
        {
          "condition": "${alltrue([for audience in values(var.routes) : contains([\"customer\", \"staff\", \"public\"], audience)])}",
          "error_message": "Supply real route keys mapped to customer, staff or public."
        }
      ]
    },
    "worker_enabled": {
      "type": "bool",
      "description": "",
      "default": false
    },
    "worker_artifact_path": {
      "type": "string",
      "description": "",
      "default": ""
    },
    "worker_handler": {
      "type": "string",
      "description": "",
      "default": "index.handler"
    },
    "alarm_topic_arn": {
      "type": "string",
      "description": ""
    },
    "application_environment": {
      "type": "map(string)",
      "default": {},
      "description": "Non-secret backend configuration and secret ARNs only. Never place secret values here.",
      "validation": [
        {
          "condition": "${length(setintersection(toset(keys(var.application_environment)),toset([\"ENVIRONMENT_NAME\",\"CORE_TABLE\",\"LEDGER_TABLE\",\"OPERATIONS_TABLE\",\"CUSTOMER_ISSUER\",\"STAFF_ISSUER\",\"CUSTOMER_CLIENT_ID\",\"STAFF_CLIENT_ID\",\"PAYMENT_SECRET_ARNS\"]))) == 0}",
          "error_message": "Application configuration cannot override infrastructure identity or table bindings."
        }
      ]
    }
  },
  "locals": {
    "functions": "${merge({api={artifact=var.artifact_path,handler=var.handler}},var.worker_enabled ? {worker={artifact=var.worker_artifact_path,handler=var.worker_handler}} : {})}"
  },
  "resource": {
    "aws_iam_role": {
      "function": {
        "for_each": "${local.functions}",
        "name": "${var.name}-${each.key}-runtime",
        "assume_role_policy": "{\"Version\": \"2012-10-17\", \"Statement\": [{\"Effect\": \"Allow\", \"Principal\": {\"Service\": \"lambda.amazonaws.com\"}, \"Action\": \"sts:AssumeRole\"}]}",
        "permissions_boundary": "${var.boundary_arn}",
        "tags": "${var.tags}"
      }
    },
    "aws_iam_role_policy": {
      "function": {
        "for_each": "${local.functions}",
        "role": "${aws_iam_role.function[each.key].id}",
        "policy": "${jsonencode({Version=\"2012-10-17\",Statement=concat([{\"Effect\" = \"Allow\", \"Action\" = [\"dynamodb:GetItem\", \"dynamodb:PutItem\", \"dynamodb:UpdateItem\", \"dynamodb:DeleteItem\", \"dynamodb:Query\", \"dynamodb:ConditionCheckItem\", \"dynamodb:DescribeTable\"], \"Resource\" = [var.table_arns.core, \"${var.table_arns.core}/index/*\", var.table_arns.operations, \"${var.table_arns.operations}/index/*\"]}, {\"Effect\" = \"Allow\", \"Action\" = [\"dynamodb:GetItem\", \"dynamodb:PutItem\", \"dynamodb:Query\", \"dynamodb:ConditionCheckItem\"], \"Resource\" = [var.table_arns.ledger, \"${var.table_arns.ledger}/index/*\"]}, {\"Effect\" = \"Allow\", \"Action\" = [\"logs:CreateLogStream\", \"logs:PutLogEvents\"], \"Resource\" = [\"arn:aws:logs:${var.region}:${var.account_id}:log-group:/aws/lambda/${var.name}-${each.key}:*\"]}],each.key == \"api\" ? [{\"Effect\" = \"Allow\", \"Action\" = [\"secretsmanager:GetSecretValue\"], \"Resource\" = var.secret_arns}] : [], var.worker_enabled ? (each.key == \"api\" ? [{\"Effect\" = \"Allow\", \"Action\" = [\"sqs:SendMessage\"], \"Resource\" = [aws_sqs_queue.work[0].arn]}] : [{\"Effect\" = \"Allow\", \"Action\" = [\"sqs:ReceiveMessage\", \"sqs:DeleteMessage\", \"sqs:GetQueueAttributes\", \"sqs:ChangeMessageVisibility\"], \"Resource\" = [aws_sqs_queue.work[0].arn]}]) : [])})}"
      }
    },
    "aws_cloudwatch_log_group": {
      "function": {
        "for_each": "${local.functions}",
        "name": "/aws/lambda/${var.name}-${each.key}",
        "retention_in_days": "${var.log_days}",
        "tags": "${var.tags}"
      },
      "api": {
        "name": "/aws/apigateway/${var.name}",
        "retention_in_days": "${var.log_days}",
        "tags": "${var.tags}"
      }
    },
    "aws_lambda_function": {
      "function": {
        "for_each": "${local.functions}",
        "function_name": "${var.name}-${each.key}",
        "role": "${aws_iam_role.function[each.key].arn}",
        "runtime": "${var.runtime}",
        "handler": "${each.value.handler}",
        "filename": "${each.value.artifact}",
        "source_code_hash": "${filebase64sha256(each.value.artifact)}",
        "architectures": [
          "${var.architecture}"
        ],
        "memory_size": "${var.memory_mb}",
        "timeout": "${var.timeout_seconds}",
        "reserved_concurrent_executions": "${var.concurrency}",
        "publish": true,
        "environment": [
          {
            "variables": "${merge({ENVIRONMENT_NAME=var.name,CORE_TABLE=var.table_names.core,LEDGER_TABLE=var.table_names.ledger,OPERATIONS_TABLE=var.table_names.operations,PAYMENT_SECRET_ARNS=jsonencode(var.secret_arns),CUSTOMER_ISSUER=var.issuers.customer,STAFF_ISSUER=var.issuers.staff,CUSTOMER_CLIENT_ID=var.clients.customer,STAFF_CLIENT_ID=var.clients.staff}, var.application_environment)}"
          }
        ],
        "tags": "${var.tags}",
        "depends_on": [
          "aws_cloudwatch_log_group.function",
          "aws_iam_role_policy.function"
        ]
      }
    },
    "aws_lambda_alias": {
      "live": {
        "for_each": "${local.functions}",
        "name": "live",
        "function_name": "${aws_lambda_function.function[each.key].function_name}",
        "function_version": "${aws_lambda_function.function[each.key].version}"
      }
    },
    "aws_apigatewayv2_api": {
      "api": {
        "name": "${var.name}",
        "protocol_type": "HTTP",
        "tags": "${var.tags}",
        "dynamic": {
          "cors_configuration": {
            "for_each": "${length(var.origins)>0 ? [1] : []}",
            "content": {
              "allow_origins": "${var.origins}",
              "allow_methods": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE",
                "OPTIONS"
              ],
              "allow_headers": [
                "authorization",
                "content-type",
                "idempotency-key"
              ],
              "max_age": 300
            }
          }
        }
      }
    },
    "aws_apigatewayv2_authorizer": {
      "jwt": {
        "for_each": "${var.issuers}",
        "api_id": "${aws_apigatewayv2_api.api.id}",
        "authorizer_type": "JWT",
        "identity_sources": [
          "$request.header.Authorization"
        ],
        "name": "${each.key}",
        "jwt_configuration": [
          {
            "issuer": "${each.value}",
            "audience": [
              "${var.clients[each.key]}"
            ]
          }
        ]
      }
    },
    "aws_apigatewayv2_integration": {
      "api": {
        "api_id": "${aws_apigatewayv2_api.api.id}",
        "integration_type": "AWS_PROXY",
        "integration_uri": "${aws_lambda_alias.live[\"api\"].invoke_arn}",
        "payload_format_version": "2.0",
        "timeout_milliseconds": "${var.timeout_seconds * 1000}"
      }
    },
    "aws_apigatewayv2_route": {
      "route": {
        "for_each": "${var.routes}",
        "api_id": "${aws_apigatewayv2_api.api.id}",
        "route_key": "${each.key}",
        "target": "integrations/${aws_apigatewayv2_integration.api.id}",
        "authorization_type": "${each.value == \"public\" ? \"NONE\" : \"JWT\"}",
        "authorizer_id": "${each.value == \"public\" ? null : aws_apigatewayv2_authorizer.jwt[each.value].id}"
      }
    },
    "aws_apigatewayv2_stage": {
      "default": {
        "api_id": "${aws_apigatewayv2_api.api.id}",
        "name": "$default",
        "auto_deploy": true,
        "default_route_settings": [
          {
            "throttling_burst_limit": 20,
            "throttling_rate_limit": 10
          }
        ],
        "access_log_settings": [
          {
            "destination_arn": "${aws_cloudwatch_log_group.api.arn}",
            "format": "{\"requestId\": \"$context.requestId\", \"status\": \"$context.status\", \"latency\": \"$context.responseLatency\", \"integrationStatus\": \"$context.integrationStatus\"}"
          }
        ],
        "tags": "${var.tags}"
      }
    },
    "aws_lambda_permission": {
      "api": {
        "statement_id": "AllowConfiguredApi",
        "action": "lambda:InvokeFunction",
        "function_name": "${aws_lambda_function.function[\"api\"].function_name}",
        "qualifier": "${aws_lambda_alias.live[\"api\"].name}",
        "principal": "apigateway.amazonaws.com",
        "source_arn": "${aws_apigatewayv2_api.api.execution_arn}/*/*",
        "source_account": "${var.account_id}"
      }
    },
    "aws_sqs_queue": {
      "dead": {
        "count": "${var.worker_enabled ? 1 : 0}",
        "name": "${var.name}-dead",
        "message_retention_seconds": 1209600,
        "sqs_managed_sse_enabled": true,
        "tags": "${var.tags}"
      },
      "work": {
        "count": "${var.worker_enabled ? 1 : 0}",
        "name": "${var.name}-work",
        "message_retention_seconds": 345600,
        "visibility_timeout_seconds": "${var.timeout_seconds * 6}",
        "sqs_managed_sse_enabled": true,
        "redrive_policy": "${jsonencode({deadLetterTargetArn=aws_sqs_queue.dead[0].arn,maxReceiveCount=5})}",
        "tags": "${var.tags}"
      }
    },
    "aws_sqs_queue_redrive_allow_policy": {
      "dead": {
        "count": "${var.worker_enabled ? 1 : 0}",
        "queue_url": "${aws_sqs_queue.dead[0].id}",
        "redrive_allow_policy": "${jsonencode({redrivePermission=\"byQueue\",sourceQueueArns=[aws_sqs_queue.work[0].arn]})}"
      }
    },
    "aws_lambda_event_source_mapping": {
      "worker": {
        "count": "${var.worker_enabled ? 1 : 0}",
        "event_source_arn": "${aws_sqs_queue.work[0].arn}",
        "function_name": "${aws_lambda_alias.live[\"worker\"].arn}",
        "batch_size": 5,
        "function_response_types": [
          "ReportBatchItemFailures"
        ]
      }
    },
    "aws_cloudwatch_metric_alarm": {
      "errors": {
        "for_each": "${local.functions}",
        "alarm_name": "${var.name}-${each.key}-errors",
        "namespace": "AWS/Lambda",
        "metric_name": "Errors",
        "dimensions": {
          "FunctionName": "${aws_lambda_function.function[each.key].function_name}"
        },
        "statistic": "Sum",
        "period": 300,
        "evaluation_periods": 1,
        "threshold": 1,
        "comparison_operator": "GreaterThanOrEqualToThreshold",
        "treat_missing_data": "notBreaching",
        "alarm_actions": [
          "${var.alarm_topic_arn}"
        ],
        "tags": "${var.tags}"
      },
      "dead": {
        "count": "${var.worker_enabled ? 1 : 0}",
        "alarm_name": "${var.name}-dead-visible",
        "namespace": "AWS/SQS",
        "metric_name": "ApproximateNumberOfMessagesVisible",
        "dimensions": {
          "QueueName": "${aws_sqs_queue.dead[0].name}"
        },
        "statistic": "Maximum",
        "period": 300,
        "evaluation_periods": 1,
        "threshold": 1,
        "comparison_operator": "GreaterThanOrEqualToThreshold",
        "treat_missing_data": "notBreaching",
        "alarm_actions": [
          "${var.alarm_topic_arn}"
        ],
        "tags": "${var.tags}"
      },
      "throttles": {
        "for_each": "${local.functions}",
        "alarm_name": "${var.name}-${each.key}-throttles",
        "namespace": "AWS/Lambda",
        "metric_name": "Throttles",
        "dimensions": {
          "FunctionName": "${aws_lambda_function.function[each.key].function_name}"
        },
        "statistic": "Sum",
        "period": 300,
        "evaluation_periods": 1,
        "threshold": 1,
        "comparison_operator": "GreaterThanOrEqualToThreshold",
        "treat_missing_data": "notBreaching",
        "alarm_actions": [
          "${var.alarm_topic_arn}"
        ],
        "tags": "${var.tags}"
      }
    }
  },
  "output": {
    "api_url": {
      "value": "${aws_apigatewayv2_api.api.api_endpoint}"
    },
    "function_names": {
      "value": "${{for k,f in aws_lambda_function.function:k=>f.function_name}}"
    }
  }
}
