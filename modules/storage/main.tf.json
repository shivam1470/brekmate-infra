{
  "variable": {
    "name": {
      "type": "string",
      "description": ""
    },
    "production": {
      "type": "bool",
      "description": ""
    },
    "tags": {
      "type": "map(string)",
      "description": "",
      "default": {}
    },
    "pitr": {
      "type": "bool",
      "description": "",
      "default": true
    }
  },
  "resource": {
    "aws_dynamodb_table": {
      "data": {
        "for_each": {
          "core": "core",
          "ledger": "ledger",
          "operations": "operations"
        },
        "name": "${var.name}-${each.key}",
        "billing_mode": "PAY_PER_REQUEST",
        "hash_key": "pk",
        "range_key": "sk",
        "attribute": [
          {
            "name": "pk",
            "type": "S"
          },
          {
            "name": "sk",
            "type": "S"
          },
          {
            "name": "gsi1pk",
            "type": "S"
          },
          {
            "name": "gsi1sk",
            "type": "S"
          }
        ],
        "global_secondary_index": [
          {
            "name": "gsi1",
            "hash_key": "gsi1pk",
            "range_key": "gsi1sk",
            "projection_type": "ALL"
          }
        ],
        "point_in_time_recovery": [
          {
            "enabled": "${var.pitr}"
          }
        ],
        "server_side_encryption": [
          {
            "enabled": true
          }
        ],
        "ttl": [
          {
            "attribute_name": "expiresAt",
            "enabled": "${each.key == \"operations\"}"
          }
        ],
        "deletion_protection_enabled": "${var.production}",
        "tags": "${var.tags}",
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "aws_secretsmanager_secret": {
      "provider": {
        "for_each": "${toset([\"gateway-api\", \"gateway-webhook\", \"delivery-otp\"])}",
        "name": "${var.name}/${each.value}",
        "description": "Secret container only; values are provisioned outside OpenTofu.",
        "recovery_window_in_days": 30,
        "tags": "${var.tags}",
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    }
  },
  "output": {
    "table_names": {
      "value": "${{for k,t in aws_dynamodb_table.data : k => t.name}}"
    },
    "table_arns": {
      "value": "${{for k,t in aws_dynamodb_table.data : k => t.arn}}"
    },
    "secret_arns": {
      "value": "${[for s in aws_secretsmanager_secret.provider : s.arn]}"
    },
    "delivery_otp_secret_arn": {
      "value": "${aws_secretsmanager_secret.provider[\"delivery-otp\"].arn}"
    }
  }
}
